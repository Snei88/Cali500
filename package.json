{
  "name": "vision-cali500-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://snei88.github.io/Cali500/",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "server:mariadb": "node server-mariadb.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "user:create": "node scripts/create-admin-user.mjs",
    "import:planning:local": "node scripts/import-planning-local.mjs",
    "export:mariadb": "node scripts/export-mariadb-cpanel.mjs",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port $PORT",
    "preview": "vite preview",
    "seed:instruments": "node scripts/import-planning-instruments.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.106.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.555.0",
    "motion": "^12.40.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.3",
    "gh-pages": "^6.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
